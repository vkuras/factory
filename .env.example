# Copy to .env (never committed) and change what you need. Every variable has the default shown.

# Published port and bind address. 127.0.0.1 locks the dashboard to the machine it runs on.
DASHBOARD_PORT=8787
DASHBOARD_BIND=0.0.0.0

# The zone every rendered time and week is shown in.
TZ=Europe/Berlin

# When a ticket needs you (R1): loops reaching this number, and hours untouched.
LOOP_THRESHOLD=3
IDLE_HOURS=24

# An unfinished run older than this many hours counts as abandoned.
RUN_STALE_HOURS=12

# When non-empty, every report must carry it as "Authorization: Bearer <token>". The reporting
# machines set the same value in ~/.factory/dashboard.env.
FACTORY_INGEST_TOKEN=
