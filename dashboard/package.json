{
  "name": "agent-factory-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dashboard for the software factory: what runs, what needs the operator, whether the factory improves.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:stack": "vitest run --config vitest.stack.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "ejs": "6.0.1",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.2",
    "cheerio": "1.2.0",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
