<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Agent Factory</title>
<link rel="stylesheet" href="/assets/app.css">
<noscript><style>section[data-panel] { display: block; }</style></noscript>
<script src="/assets/app.js" defer></script>
</head>
<body>
<div style="min-height:100vh;background:#0A0C0F;color:#E6E9EE;font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:14px;line-height:1.45;padding:28px 32px 64px;display:flex;flex-direction:column;gap:22px">

  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap">
    <div style="display:flex;flex-direction:column;gap:4px">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.22em;color:#6E7887;text-transform:uppercase">Control room</div>
      <div style="font-size:26px;font-weight:600;letter-spacing:-.02em">Agent Factory</div>
    </div>
    <div style="display:flex;align-items:center;gap:10px;font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8A94A3">
      <span style="width:7px;height:7px;border-radius:50%;background:<%= online.color %>;<%= online.pulsing ? 'animation:af-pulse 2s infinite' : '' %>"></span>
      <span><%= online.text %></span>
    </div>
  </div>

<%- body %>

</div>
</body>
</html>
