  <div style="display:flex;flex-direction:column;gap:14px">
<% if (m.attention.length > 0) { %>
    <div style="display:flex;flex-direction:column;gap:10px">
<% for (const t of m.attention) { %>
      <a href="<%= t.href %>" class="af-h-attn" style="cursor:pointer;color:#E6E9EE;background:#12151A;border:1px solid #1E242C;border-left:3px solid <%= t.attention.color %>;border-radius:10px;padding:16px 18px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:start">
        <div style="display:flex;flex-direction:column;gap:9px;min-width:0">
          <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8A94A3"><%- include('partials/ticketId', { c: t }) %></span>
            <span style="font-size:15px;font-weight:600"><%= t.title %></span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:5px;background:<%= t.attention.background %>;color:<%= t.attention.color %>"><%= t.attention.reason %></span>
          </div>
          <div style="font-size:13px;color:#A6B0BE;text-wrap:pretty"><%= t.attention.note %></div>
          <div style="display:flex;gap:16px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6E7887">
            <span>status · <span style="color:#A6B0BE"><%= t.statusText %></span></span>
            <span>owner · <span style="color:<%= t.ownerColor %>"><%= t.ownerLabel %></span></span>
            <span>idle · <span style="color:#A6B0BE"><%= t.idleLabel %></span></span>
            <span>loops · <span style="color:#A6B0BE"><%= t.loops %></span></span>
            <span>you · <span style="color:#A6B0BE"><%= t.interventions %>x</span></span>
          </div>
        </div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:10px">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:<%= t.attention.color %>"><%= t.attention.severity %></div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6E7887;padding:6px 12px;border:1px solid #2C343F;border-radius:6px;white-space:nowrap">open ticket →</div>
        </div>
      </a>
<% } %>
    </div>
<% } else { %>
    <div style="background:#12151A;border:1px solid #1E242C;border-left:3px solid #9EE84B;border-radius:10px;padding:16px 18px;display:flex;flex-direction:column;gap:6px">
      <div style="font-size:18px;color:#E6E9EE">Nothing needs you.</div>
      <div style="font-size:13px;color:#A6B0BE">All <%= m.calm.length %> tickets are running on their own.</div>
    </div>
<% } %>

    <div style="margin-top:8px;display:flex;flex-direction:column;gap:8px">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#6E7887">Running on their own · <%= m.calm.length %></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:8px">
<% for (const t of m.calm) { %>
        <a href="<%= t.href %>" class="af-h-chip" style="cursor:pointer;color:#E6E9EE;background:#0F1216;border:1px solid #191E25;border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:10px">
          <span style="width:6px;height:6px;border-radius:50%;background:<%= t.ownerColor %>;flex:none"></span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#6E7887;flex:none;white-space:nowrap"><%- include('partials/ticketId', { c: t }) %></span>
          <span style="font-size:12px;color:#A6B0BE;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= t.title %></span>
        </a>
<% } %>
      </div>
    </div>
  </div>
