diff --git a/src/search.js b/src/search.js
new file mode 100644
index 0000000..0e38304
--- /dev/null
+++ b/src/search.js
@@ -0,0 +1,7 @@
+// S6: the "open only" filter. Hides done tasks so a team member sees only
+// what is left (R4's text-matching half of this file, `matchesQuery()`, is
+// blocked by a design/requirements contradiction — see
+// docs/architecture/.gaps/002-find-a-task.md, G1 — and is not built yet).
+export function filterTasks(tasks, { open } = {}) {
+  return open ? tasks.filter((task) => !task.done) : tasks;
+}
diff --git a/test/search.test.js b/test/search.test.js
new file mode 100644
index 0000000..8521add
--- /dev/null
+++ b/test/search.test.js
@@ -0,0 +1,30 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { filterTasks } from '../src/search.js';
+
+const tasks = [
+  { id: 1, title: 'Buy milk', done: false },
+  { id: 2, title: 'Order milk crate', done: true },
+  { id: 3, title: 'Milk bill', done: false },
+];
+
+test('S6.1 keeps only the tasks that are not done when open is true', () => {
+  const result = filterTasks(tasks, { open: true });
+  assert.deepEqual(result.map((t) => t.id), [1, 3]);
+});
+
+test('S6.3 returns every task again when open is false', () => {
+  const result = filterTasks(tasks, { open: false });
+  assert.deepEqual(result.map((t) => t.id), [1, 2, 3]);
+});
+
+test('open defaults to showing every task when omitted', () => {
+  const result = filterTasks(tasks, {});
+  assert.deepEqual(result.map((t) => t.id), [1, 2, 3]);
+});
+
+test('does not mutate the input array', () => {
+  const copy = tasks.map((t) => ({ ...t }));
+  filterTasks(copy, { open: true });
+  assert.deepEqual(copy, tasks);
+});
diff --git a/tests/acceptance/002-find-a-task/tasks.test.js b/tests/acceptance/002-find-a-task/tasks.test.js
new file mode 100644
index 0000000..b360ea4
--- /dev/null
+++ b/tests/acceptance/002-find-a-task/tasks.test.js
@@ -0,0 +1,28 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { api, withTask } from '../helpers.js';
+
+// S5 (search by text) is not covered here yet: the design's match rule
+// contradicts R4/S5.2/S5.3 and is blocked on an architect decision — see
+// docs/architecture/.gaps/002-find-a-task.md, G1. Only S6 (open only),
+// as far as it does not depend on the search text, is built.
+
+test('S6.1 open=true hides done tasks', async () => {
+  await withTask({ title: 'still open one' }, async (open) => {
+    await withTask({ title: 'finished one' }, async (done) => {
+      await api('PATCH', `/api/tasks/${done.id}`, { done: true });
+      const { body } = await api('GET', '/api/tasks?open=true');
+      const ids = body.tasks.map((t) => t.id);
+      assert.ok(ids.includes(open.id));
+      assert.ok(!ids.includes(done.id));
+    });
+  });
+});
+
+test('S6.3 switching open=true off shows done tasks again', async () => {
+  await withTask({ title: 'to finish' }, async (task) => {
+    await api('PATCH', `/api/tasks/${task.id}`, { done: true });
+    const { body } = await api('GET', '/api/tasks');
+    assert.ok(body.tasks.some((t) => t.id === task.id));
+  });
+});
